# Realtime WebSocket server
PORT=3001

# PostgreSQL
DATABASE_URL=postgres://username:password@localhost:5432/metaverse?sslmode=disable

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins permitted to open WebSocket connections.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
